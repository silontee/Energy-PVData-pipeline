          "rawSql": "SELECT\r\n  g.timestamp AS \"time\",\r\n  g.generation AS \"value\",\r\n  -- 호기별로 선을 구분하여 시각화\r\n  p.plant_name || ' (' || g.hogi || '호기)' AS \"metric\"\r\nFROM pv_generation g\r\nJOIN plant_info p ON g.gencd = p.gencd AND g.hogi = p.hogi\r\nWHERE \r\n  $__timeFilter(g.timestamp) -- 우측 상단 시간 선택기에 따라 변함\r\n  AND p.plant_name IN ($plant) -- 선택한 발전소들만 필터링\r\nORDER BY 1 ASC;",
